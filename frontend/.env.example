# ─── MachineIQ Frontend (Next.js) ──────────────────────────────────
# Copy to `.env.local` for local dev. In production (Render), set
# these in the service's Environment tab.
#
# NOTE: `NEXT_PUBLIC_*` variables are inlined into the client bundle
# at build time. Changing them requires a redeploy.

# REST API base URL (must include /api prefix)
# Local:       http://localhost:4051/api
# Production:  https://api.machineiq.tech/api   (or https://machineiq-api.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:4051/api

# Socket.IO endpoint (no /api prefix)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4051

# Inactivity sign-out. The warning countdown is shown inside the idle window,
# so 30 + 120 means: warn at 28 minutes idle, sign out at 30.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_IDLE_WARNING_SECONDS=120
