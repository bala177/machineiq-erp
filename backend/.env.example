# ─── MachineIQ Backend (NestJS) ────────────────────────────────────
# Copy to `.env` for local dev. In production (Render), set these in
# the service's Environment tab — never commit real secrets.

# PostgreSQL connection string. PostgreSQL is the system of record.
DATABASE_URL=postgresql://machineiq:machineiq@localhost:5432/machineiq
DATABASE_SSL=false
DATABASE_LOGGING=false
# Apply committed schema migrations whenever the API starts. Set this to false
# only if your deployment runs migrations in a separate release step.
RUN_MIGRATIONS_ON_STARTUP=true

# JWT signing secret — minimum 32 chars, must NOT start with "change-this".
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret-of-at-least-32-chars
JWT_EXPIRATION=8h

# HTTP port. Leave UNSET on Render — the platform injects PORT automatically.
PORT=4051

# CORS allow-list — comma separated, no trailing slash, must match scheme.
# Local:       http://localhost:4050
# Production:  https://www.machineiq.tech,https://machineiq.tech
CORS_ORIGIN=http://localhost:4050

# Node runtime mode — set to "production" on Render
NODE_ENV=development
